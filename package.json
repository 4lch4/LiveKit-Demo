{
  "name": "on-call-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome ci .",
    "dev": "lk agent dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "start": "node src/main.ts start",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.0",
    "@livekit/plugins-ai-coustics": "^0.3.2",
    "@livekit/rtc-node": "^0.13.35",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
