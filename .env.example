LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shion, the notification bot the sendAlert tool posts to. Base URL only — the
# tool appends the path itself, per docs/agents/shion-contract.md.
SHION_URL=http://host.docker.internal:3300
SHION_API_TOKEN=

# JSON array of servers for the checkServers tool to probe. Each entry needs a
# name and a url. `expect` is a substring the body must contain, and `headers`
# exists for endpoints like Shion's /v1/status that need a bearer token.
# Single-line here because dotenv does not parse multi-line values.
HEALTH_TARGETS=[{"name":"Shion API","url":"http://host.docker.internal:3300/v1/status","expect":"\"status\":\"ready\"","headers":{"Authorization":"Bearer replace-with-SHION_API_TOKEN"}},{"name":"droplet","url":"https://example.com","expect":"ok"}]